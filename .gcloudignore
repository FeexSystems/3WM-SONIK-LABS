# .gcloudignore — Clean Source Bundling Config for Google Cloud Build
# Exclude heavy local modules and configuration secrets to speed up source zip upload

.gcloudignore
.git
.gitignore
node_modules/
.firebase/

.temp/
.vscode/
.idea/
.vs/
.windsurf/
tmp/
temp/
logs/
*.log
*.tmp
*.key
*.pem
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
firebase-applet-config.json
firebase-blueprint.json
tsc-errors.txt
tsc-out.log
playwright-report/
test-results/
