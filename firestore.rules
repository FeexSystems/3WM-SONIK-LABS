rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /tracks/{trackId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource == null);
      allow write: if request.auth != null && (request.resource.data.userId == request.auth.uid);
    }
    
    match /generation_jobs/{jobId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || resource == null);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Allow updates only by the server or if it matches the userId
      allow update: if request.auth != null && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
    }
  }
}
