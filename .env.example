# 3WM SONIK — Environment Template
# Copy to .env and fill. Never commit .env. See AGENTS.md.
# Vite dev server owns :3000 — API must be :3001 (vite.config.ts proxy /api → localhost:3001).

# ── Database ──────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
POSTGRES_URL=postgresql://postgres.<project>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DATABASE=

# ── AI Services ───────────────────────────────────────────────────────
GEMINI_API_KEY=
# Accepted aliases (one is enough):
GOOGLE_API_KEY=
GEMINI_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
ELEVENLABS_API_KEY=
GROK_API_KEY=
PERPLEXITY_API_KEY=
TRUEFOUNDRY_API_KEY=
DEEPGRAM_API_KEY=
OLLAMA_API_KEY=

# ── ElevenLabs ────────────────────────────────────────────────────────
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_DEFAULT_VOICE=
ELEVENLABS_CACHE_ENABLED=true
ELEVENLABS_MAX_CACHE_SIZE=100
ELEVENLABS_API_ID=

# ── Vector DB (Agent Memory) ──────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
PINECONE_INDEX_NAME=
WEAVIATE_URL=
WEAVIATE_API_KEY=

# ── Firebase (client — server reads these too via env.ts getEnv) ─────
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_OAUTH_CLIENT_ID=
FIREBASE_RECAPTCHA_SITE_KEY=

# Firebase (client-side — Vite requires VITE_ prefix; same values as above)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Firestore
FIRESTORE_DATABASE_ID=
FIRESTORE_LOCATION=europe-west2
FIRESTORE_PERSISTENCE_ENABLED=true
FIRESTORE_OFFLINE_ENABLED=true
FIRESTORE_CACHE_SIZE_BYTES=10485760

# Firebase Auth toggles
FIREBASE_AUTH_ENABLED=true
FIREBASE_AUTH_EMAIL_PASSWORD_ENABLED=true
FIREBASE_AUTH_GOOGLE_ENABLED=true
FIREBASE_AUTH_GITHUB_ENABLED=false
FIREBASE_AUTH_TWITTER_ENABLED=false
FIREBASE_AUTH_FACEBOOK_ENABLED=false
FIREBASE_AUTH_ANONYMOUS_ENABLED=true
FIREBASE_AUTH_PHONE_ENABLED=false

# Firebase Storage
FIREBASE_STORAGE_MAX_UPLOAD_SIZE_MB=100
FIREBASE_STORAGE_ALLOWED_FILE_TYPES=audio/*,image/*,application/json
FIREBASE_STORAGE_CACHE_CONTROL=public,max-age=3600

# Firebase Functions
FIREBASE_FUNCTIONS_REGION=us-central1
FIREBASE_FUNCTIONS_TIMEOUT_SECONDS=540
FIREBASE_FUNCTIONS_MEMORY=512MB

# Firebase Realtime DB — also used for presence/cursors (database.rules.json)
FIREBASE_REALTIME_DATABASE_URL=https://<project>-default-rtdb.firebaseio.com
FIREBASE_REALTIME_DATABASE_ENABLED=true

# Firebase Admin (service account — from Firebase Console → Service Accounts)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@<project>.iam.gserviceaccount.com
FIREBASE_ADMIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n
FIREBASE_ADMIN_PRIVATE_KEY_ID=

# ── Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_SECRET=your-generated-jwt-secret-minimum-32-characters
JWT_EXPIRATION=7d
SESSION_SECRET=your-generated-session-secret-minimum-32-characters
ENCRYPTION_KEY=

# ── Redis ─────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_DB=0

# ── QStash (background jobs) ──────────────────────────────────────────
QSTASH_URL=https://qstash-us-east-1.upstash.io
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=sig_...
QSTASH_NEXT_SIGNING_KEY=sig_...
# Coarse daily ceiling on paid Gemini voice generations (landing demo is public)
VOICE_DAILY_CALL_CAP=500

# ── Object Storage (AWS S3 / Supabase S3) ─────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
AWS_ENDPOINT_URL=https://<project>.storage.supabase.co/storage/v1/s3
AWS_S3_BUCKET=3wm-audio

# ── App ───────────────────────────────────────────────────────────────
NODE_ENV=development
# API server — Vite owns 3000, so this must be 3001 (and match vite.config.ts proxy)
PORT=3001
HOST=0.0.0.0
API_BASE_URL=http://localhost:3001
# Restrict Supabase edge-function CORS (also used for /api CORS allowlist)
ALLOWED_ORIGINS=https://3wm-sonik.com,https://www.3wm-sonik.com
SOCKET_IO_CORS_ORIGIN=
# Swagger UI (/api-docs) is only mounted when this is true (plus dev)
ENABLE_API_DOCS=false

# ── Audio Engine ──────────────────────────────────────────────────────
AUDIO_BUFFER_SIZE=16384
AUDIO_SAMPLE_RATE=48000
AUDIO_BIT_DEPTH=24

# ── Collaboration ─────────────────────────────────────────────────────
COLLABORATION_ENABLED=true
ALLOW_DEV_AUTH_BYPASS=false

# ── Monitoring ────────────────────────────────────────────────────────
SENTRY_DSN=
LOG_LEVEL=info

# ── Stripe (Fiat Subscriptions) ───────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
VITE_STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_CREATOR=price_creator_...
STRIPE_PRICE_PRO_STUDIO=price_pro_...
STRIPE_PRICE_MASTER_LABEL=price_label_...

# ── Paystack (African & International Card / Mobile Money / Bank Transfer) ─
PAYSTACK_SECRET_KEY=sk_live_...
PAYSTACK_PUBLIC_KEY=pk_live_...
VITE_PAYSTACK_PUBLIC_KEY=pk_live_...

# ── Crypto & Web3 Digital Asset Payments ──────────────────────────────
# Coinbase Commerce API Key (for automated hosted crypto checkouts)
COINBASE_COMMERCE_API_KEY=
COINBASE_WEBHOOK_SECRET=
# Helio API Key (Solana / Web3 native pay links)
HELIO_API_KEY=
# Direct safe wallet deposit address for USDC/USDT/ETH/SOL
WEB3_DEPOSIT_WALLET_ADDRESS=0x3WM7A890F3B9A8912E1E6B9D8B2C4E0A8F2E1B4C

# ── Apify (Market Intelligence) ───────────────────────────────────────
APIFY_API_TOKEN=
APIFY_ACTOR_TIKTOK_TRENDS=
APIFY_ACTOR_SPOTIFY_CHARTS=
APIFY_ACTOR_INFLUENCER_DISCOVERY=

